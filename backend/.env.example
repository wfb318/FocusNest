APP_NAME=FocusNest
DEBUG=false
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=focusnest
MYSQL_USER=focusnest
MYSQL_PASSWORD=replace-with-your-local-password

# Generate a random secret of at least 32 characters; never commit the actual key.
JWT_SECRET=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
# Set true when served over HTTPS.
COOKIE_SECURE=false

# Optional until protected business storage is enabled. Absolute path OUTSIDE the project.
# Example: D:/FocusNest-secrets/content-keyring.json (restrict file and parent directory ACLs).
# Store only a path here, never key material. Restart all workers after changing a keyring.
CONTENT_KEYRING_FILE=
